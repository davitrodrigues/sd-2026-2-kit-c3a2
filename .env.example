# copie para .env:  cp .env.example .env   (o .env nunca vai para o git)

# --- gateway: autenticacao (TROQUE em producao) ---
JWT_SEGREDO=troque-este-segredo
JWT_EXPIRA_MINUTOS=30
GATEWAY_USUARIO=admin
GATEWAY_SENHA=troque-esta-senha

# --- gateway: rate limit ---
LIMITE_POR_MINUTO=10
LIMITE_LOGIN_POR_MINUTO=5

# --- portas publicadas na maquina ---
GATEWAY_PORTA=8000
REDIS_PORTA=6379

# --- descoberta de servicos (nomes do docker-compose) ---
REDIS_URL=redis://redis:6379/0
URL_INFERENCIA=http://inferencia:8001

# --- resiliencia (TAREFA 6) ---
# gateway -> inferencia: tempo-limite (s), tentativas e espera inicial (s,
# dobra a cada tentativa); o disjuntor abre apos N falhas e testa apos X s
INFERENCIA_TIMEOUT_CONEXAO=1
INFERENCIA_TIMEOUT_LEITURA=3
INFERENCIA_TENTATIVAS=3
INFERENCIA_ESPERA_BASE=0.2
DISJUNTOR_LIMITE_FALHAS=3
DISJUNTOR_ESPERA_SEGUNDOS=15
# inferencia/worker -> redis: tempo-limite (s) e tentativas do cliente
REDIS_TIMEOUT=1
REDIS_TENTATIVAS=1
# worker com o redis fora: espera inicial e teto (s) entre as tentativas
WORKER_ESPERA_REDIS_BASE=1
WORKER_ESPERA_REDIS_MAXIMA=30

# --- LGPD: retencao (TAREFA 9) ---
# prazo (s) que o resultado fica no redis antes de se apagar sozinho (24h)
RESULTADO_TTL_SEGUNDOS=86400
# maximo de itens na fila de descarte (so id e erro, sem o texto)
DESCARTE_MAXIMO=1000

# --- quantos workers consomem a fila ---
WORKERS=2

# --- observabilidade (TAREFA 7) ---
# sem a variavel, o compose manda os spans para http://jaeger:4318; definida
# vazia, desliga o rastreamento. na nuvem sem jaeger, nao defina. o nome de
# cada servico (OTEL_SERVICE_NAME) ja esta no docker-compose.yml
# OTEL_EXPORTER_OTLP_ENDPOINT=
# porta da interface do jaeger, publicada so em 127.0.0.1
JAEGER_PORTA=16686
